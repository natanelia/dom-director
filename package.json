{
  "name": "dom-director-design",
  "version": "0.0.0",
  "private": true,
  "description": "Cinematic live-DOM walkthrough implementation candidate, design atlas and tested SDK consumer.",
  "license": "MIT",
  "scripts": {
    "validate": "python3 tools/check_design.py",
    "test": "python3 tools/check_design.py && python3 -m unittest discover -s tests -v",
    "build:runtime": "python3 tools/build_runtime.py",
    "build:types": "python3 tools/build_types.py",
    "test:core": "python3 tools/build_runtime.py && node --test packages/core/test/*.test.js",
    "test:react:store": "node --test packages/react/test/*.test.js",
    "test:packages": "python3 tools/check_packages.py",
    "site:build": "python3 tools/build_runtime.py && python3 tools/build_site.py",
    "test:site": "node --test site-tests/model.test.mjs && python3 site-tests/build_test.py",
    "test:runtime:browser": "python3 -m unittest discover -s runtime-tests -p '*_test.py' -v",
    "demo:build": "python3 demo/build.py",
    "test:demo": "node --test demo/tests/model.test.cjs",
    "test:demo:browser": "python3 demo/tests/browser_test.py"
  }
}
