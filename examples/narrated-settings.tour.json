{
  "schemaVersion": "0.1.0-draft.1",
  "id": "settings-narrated",
  "title": "Review settings with timed captions",
  "locale": "en",
  "entryScene": "settings",
  "modes": [
    "watch",
    "guide"
  ],
  "capabilities": [],
  "targets": {
    "panel": {
      "ref": "settings.panel"
    },
    "save": {
      "ref": "settings.save"
    }
  },
  "defaults": {
    "easing": "gentle",
    "maxScale": 3,
    "motion": "respect-user",
    "captions": "on"
  },
  "scenes": [
    {
      "id": "settings",
      "title": "Review settings",
      "summary": "Review changes before saving. The cursor here is visual only.",
      "durationMs": 7000,
      "cues": [
        {
          "id": "settings-frame",
          "kind": "camera",
          "at": 0,
          "durationMs": 600,
          "target": "panel"
        },
        {
          "id": "save-caption-pointer",
          "kind": "cursor",
          "at": {
            "narrationCue": "review-save",
            "edge": "start",
            "offsetMs": 0
          },
          "durationMs": 500,
          "target": "save",
          "gesture": "point"
        },
        {
          "id": "save-frame",
          "kind": "camera",
          "at": {
            "narrationCue": "review-save",
            "edge": "start",
            "offsetMs": -200
          },
          "durationMs": 700,
          "maxScale": 2.5,
          "target": "save"
        },
        {
          "id": "save-highlight",
          "kind": "highlight",
          "at": {
            "narrationCue": "review-save",
            "edge": "start"
          },
          "durationMs": 2200,
          "target": "save",
          "style": "outline"
        },
        {
          "id": "settings-reset",
          "kind": "camera",
          "at": 6000,
          "durationMs": 700,
          "reset": true
        }
      ],
      "narration": {
        "transcript": "Review the settings in this panel. The Save button applies your changes. This walkthrough only points to it; it does not save anything.",
        "cues": [
          {
            "id": "review-panel",
            "startMs": 0,
            "endMs": 2200,
            "text": "Review the settings in this panel."
          },
          {
            "id": "review-save",
            "startMs": 2500,
            "endMs": 4700,
            "text": "The Save button applies your changes."
          },
          {
            "id": "visual-only",
            "startMs": 4800,
            "endMs": 6900,
            "text": "This walkthrough only points to it; it does not save anything."
          }
        ]
      }
    }
  ]
}
