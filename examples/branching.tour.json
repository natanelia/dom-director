{
  "schemaVersion": "0.1.0-draft.1",
  "id": "choose-explanation",
  "title": "Choose your explanation",
  "locale": "en",
  "entryScene": "choose",
  "modes": [
    "watch",
    "guide"
  ],
  "capabilities": [],
  "targets": {
    "overview": {
      "ref": "dashboard.overview"
    },
    "basic": {
      "ref": "dashboard.filters"
    },
    "advanced": {
      "ref": "dashboard.rules"
    }
  },
  "defaults": {
    "easing": "gentle",
    "maxScale": 3,
    "motion": "respect-user",
    "captions": "on"
  },
  "scenes": [
    {
      "id": "choose",
      "title": "Choose a path",
      "summary": "Choose basic filtering or advanced rules.",
      "durationMs": 1500,
      "cues": [
        {
          "id": "choose-overview",
          "kind": "camera",
          "at": 0,
          "durationMs": 600,
          "maxScale": 1.2,
          "target": "overview"
        }
      ],
      "choices": [
        {
          "id": "basic-path",
          "label": "Explain basic filters",
          "next": "basic"
        },
        {
          "id": "advanced-path",
          "label": "Explain advanced rules",
          "next": "advanced"
        }
      ]
    },
    {
      "id": "basic",
      "title": "Basic filters",
      "summary": "Filters narrow the visible items.",
      "durationMs": 2200,
      "cues": [
        {
          "id": "basic-frame",
          "kind": "camera",
          "at": 0,
          "durationMs": 600,
          "target": "basic"
        }
      ],
      "next": "end"
    },
    {
      "id": "advanced",
      "title": "Advanced rules",
      "summary": "Rules combine multiple filtering conditions.",
      "durationMs": 3000,
      "cues": [
        {
          "id": "advanced-frame",
          "kind": "camera",
          "at": 0,
          "durationMs": 600,
          "target": "advanced"
        }
      ],
      "next": "end"
    },
    {
      "id": "end",
      "title": "Return to the app",
      "summary": "Continue using the app at your own pace.",
      "durationMs": 1200,
      "cues": [
        {
          "id": "choice-reset",
          "kind": "camera",
          "at": 0,
          "durationMs": 700,
          "reset": true
        }
      ]
    }
  ]
}
